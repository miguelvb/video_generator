OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional override. The project default is google/gemini-3.1-flash-image.
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image

# OpenAI bilingual female TTS
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=shimmer

# Optional: organization admin key for future OpenAI billing/usage reconciliation.
# Do not use this unless you intentionally provide an OpenAI admin key.
# OPENAI_ADMIN_KEY=your_openai_admin_key_here
