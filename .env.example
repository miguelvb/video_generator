# Copy to .env and fill in. Never commit .env.

# Narration (OpenAI text-to-speech)
OPENAI_API_KEY=your_openai_api_key_here

# Still images and optional AI video (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Machine-wide model defaults. config/defaults.json has the same defaults;
# values in the script's MODELS section override both.
# DEFAULT_IMAGE_PROVIDER=openrouter
# DEFAULT_IMAGE_MODEL=google/gemini-3.1-flash-image
# DEFAULT_TTS_PROVIDER=openai
# DEFAULT_TTS_MODEL=gpt-4o-mini-tts
# DEFAULT_TTS_VOICE=shimmer
# DEFAULT_VIDEO_PROVIDER=openrouter
# DEFAULT_VIDEO_MODEL=bytedance/seedance-2.0-mini
# DEFAULT_VIDEO_RESOLUTION=480p
# DEFAULT_VIDEO_ASPECT_RATIO=16:9
# DEFAULT_VIDEO_GENERATE_AUDIO=false

# Pipeline tuning
# TTS_SEGMENT_GAP_SECONDS=0.12      # silence between narration segments in a scene
# ENABLE_WORD_TIMINGS=false         # true = Whisper word timestamps in audioTimings.ts (costs money)
# VIDEO_POLL_INTERVAL_SECONDS=30
# VIDEO_POLL_TIMEOUT_SECONDS=3600
