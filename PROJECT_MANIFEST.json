{
  "name": "ai-video-engine-content-first",
  "version": "5.0.0",
  "source_of_truth": "project/script.md",
  "engine": {
    "parser": "scripts/script_parser.py",
    "orchestrator": "scripts/orchestrator.py",
    "animation": [
      "Remotion",
      "SVG"
    ],
    "encoding": "FFmpeg",
    "ai_video": "OpenRouter asynchronous video API (optional)"
  },
  "generated_artifacts": [
    "build/",
    "src/generated/videoContent.ts",
    "src/generated/videoConfig.ts",
    "src/generated/audioTimings.ts",
    "public/assets/generated/",
    "public/audio/",
    "public/video/"
  ],
  "rule": "For a new video, edit project/script.md; do not edit generated JSON/TS artifacts manually.",
  "configuration_precedence": [
    "config/defaults.json",
    "environment variables in .env",
    "project/script.md overrides",
    "resolved configuration recorded in build/runs"
  ],
  "asset_reuse": "Generated assets are reused only when their content/configuration hash matches the current script.",
  "configuration_files": [
    "config/defaults.json",
    ".env",
    "project/script.md"
  ],
  "video_model": "bytedance/seedance-2.0-mini",
  "video_resolution": "480p"
}
